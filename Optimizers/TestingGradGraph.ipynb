   "cell_type": "code",
   "source": [
    "x = Variable(2.)\n",
    "p = Variable(3.0)\n",
    "y = x ** p        # 2^3 = 8\n",
    "y.backward()\n",
    "print(x.grad)     # should be 3 * 2^(3-1) = 12\n",
    "print(p.grad)     # should be 8 * ln(2) ≈ 8 * 0.693 = 5.545"
   ],
